{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://family-tech-platform.local/smike/plan.schema.json",
  "title": "SMIKE Codex Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "plan_id",
    "objective",
    "scope",
    "depends_on",
    "allowed_files",
    "blocked_files",
    "write_scope",
    "preflight",
    "verify_commands",
    "acceptance_criteria",
    "postflight"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "const": "codex"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "type": ["string", "null"]
    },
    "spec": {
      "type": ["string", "null"]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?:[^:\\s]+|[^:\\s]+:[^:\\s]+)$"
      }
    },
    "feature_flags": {
      "type": "object"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowed_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "blocked_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "write_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "allowed_files", "blocked_files"],
      "properties": {
        "mode": {
          "const": "strict"
        },
        "allowed_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "blocked_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["require_clean_worktree", "required_tools", "required_env_vars"],
      "properties": {
        "require_clean_worktree": {
          "type": "boolean"
        },
        "required_tools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_env_vars": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "verify_commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "run"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "run": {
            "type": "string",
            "minLength": 1
          },
          "cwd": {
            "type": "string"
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1
          },
          "expect": {
            "$ref": "#/$defs/expectation"
          }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "command_ids", "signals"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "command_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "signals": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["command_id", "expected_signal"],
              "properties": {
                "command_id": {
                  "type": "string",
                  "minLength": 1
                },
                "expected_signal": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Signal format: exit=<n> && stdout~<text> && stderr~<text>"
                }
              }
            }
          }
        }
      }
    },
    "postflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands"],
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "run"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "run": {
                "type": "string",
                "minLength": 1
              },
              "cwd": {
                "type": "string"
              },
              "timeout_ms": {
                "type": "integer",
                "minimum": 1
              },
              "expect": {
                "$ref": "#/$defs/expectation"
              }
            }
          }
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "auto_continue": {
          "type": "boolean"
        },
        "pause_reason": {
          "type": "string",
          "minLength": 1
        },
        "stop_on_failure": {
          "type": "boolean"
        },
        "max_phases_per_run": {
          "type": "integer",
          "minimum": 1
        },
        "phase_plans": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["local_only", "runtime_subagents", "auto"]
        },
        "owner": {
          "type": "string",
          "enum": ["smike_runner", "runtime_orchestrator"]
        },
        "runtime_roles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dispatch_artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "result_artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "orchestration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stage": {
          "type": "string",
          "enum": ["planning", "execution"]
        },
        "discovery_propagation": {
          "type": "boolean"
        },
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "strategist": {
              "$ref": "#/$defs/orchestrationRole"
            },
            "detailer": {
              "$ref": "#/$defs/orchestrationRole"
            },
            "checker": {
              "$ref": "#/$defs/orchestrationRole"
            },
            "auditor": {
              "$ref": "#/$defs/orchestrationRole"
            },
            "executor": {
              "$ref": "#/$defs/orchestrationRole"
            },
            "judge": {
              "$ref": "#/$defs/orchestrationRole"
            },
            "reviewer": {
              "$ref": "#/$defs/orchestrationRole"
            },
            "fixer": {
              "$ref": "#/$defs/orchestrationRole"
            }
          }
        }
      }
    },
    "quality_gates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "judge": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rerun_verify": {
              "type": "boolean"
            }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "focus_areas": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "anti_patterns": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "orchestrationRole": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "fresh_context": {
          "type": "boolean"
        },
        "independent": {
          "type": "boolean"
        },
        "focus_areas": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "anti_patterns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "additional_context": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exit_code": {
          "type": "integer"
        },
        "stdout_includes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "stderr_includes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
      }
    }
  }
}
