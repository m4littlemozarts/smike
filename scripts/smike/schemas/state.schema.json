{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://family-tech-platform.local/smike/state.schema.json",
  "title": "SMIKE Codex State",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "profile",
    "project",
    "created_at",
    "updated_at",
    "current_plan",
    "lifecycle",
    "workflow",
    "history"
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "lifecycleStatus": {
      "type": "string",
      "enum": [
        "planning_draft",
        "planning",
        "ready",
        "running",
        "in_progress",
        "awaiting_runtime_dispatch",
        "awaiting_fresh_session",
        "planning_blocked",
        "blocked",
        "failed",
        "complete"
      ]
    },
    "workflowPlanStatus": {
      "type": "string",
      "enum": [
        "pending",
        "complete",
        "failed"
      ]
    },
    "lifecycleAdvanceBehavior": {
      "type": "string",
      "enum": [
        "follow_next_command",
        "stop_at_fresh_session_gate",
        "spawn_only",
        "reconcile_dispatches",
        "execute_state_machine"
      ]
    },
    "runtimeRole": {
      "type": "string",
      "enum": [
        "strategist",
        "detailer",
        "checker",
        "auditor",
        "executor",
        "judge",
        "reviewer",
        "fixer"
      ]
    },
    "runtimeDispatchStatus": {
      "type": "string",
      "enum": [
        "queued",
        "spawned",
        "completed",
        "stale",
        "failed"
      ]
    },
    "dependencyRef": {
      "type": "string",
      "pattern": "^(?:[^:\\s]+|[^:\\s]+:[^:\\s]+)$"
    },
    "stringArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "workflowPlan": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "plan_id",
        "plan_json",
        "depends_on"
      ],
      "properties": {
        "plan_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "plan_json": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "plan_md": {
          "$ref": "#/$defs/nullableString"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependencyRef"
          }
        },
        "status": {
          "$ref": "#/$defs/workflowPlanStatus"
        },
        "contract_changed": {
          "type": "boolean"
        }
      }
    },
    "propagatedDiscovery": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "source_plan_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "target_plan_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "discoveries": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "dependencyBlocker": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "plan_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "unmet_dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "actionableDependencyTarget": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "plan_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "status": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "dispatchFreshness": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "fresh",
            "stale",
            "missing",
            "unchanged"
          ]
        },
        "checked_at": {
          "$ref": "#/$defs/nullableString"
        },
        "reason": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "runtimeDispatchOwner": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "$ref": "#/$defs/nullableString"
        },
        "pid": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "host": {
          "$ref": "#/$defs/nullableString"
        },
        "command": {
          "$ref": "#/$defs/nullableString"
        },
        "claimed_at": {
          "$ref": "#/$defs/nullableString"
        },
        "lease_duration_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "lease_expires_at": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "dispatchCompletionRequirements": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "require_artifact_change": {
          "type": "boolean"
        },
        "artifact_requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "path": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "json",
                  "text",
                  "file"
                ]
              },
              "must_exist": {
                "type": "boolean"
              },
              "must_be_nonempty": {
                "type": "boolean"
              },
              "must_parse_json": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "runtimeDispatchEntry": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "dispatch_id",
        "plan_id",
        "role",
        "group",
        "status"
      ],
      "properties": {
        "dispatch_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "plan_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "role": {
          "$ref": "#/$defs/runtimeRole"
        },
        "group": {
          "type": "integer",
          "minimum": 1
        },
        "current": {
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/runtimeDispatchStatus"
        },
        "freshness": {
          "$ref": "#/$defs/dispatchFreshness"
        },
        "completion_requirements": {
          "$ref": "#/$defs/dispatchCompletionRequirements"
        }
      }
    },
    "runtimeDispatchViewActionablePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_id",
        "plan_ids",
        "group",
        "completable_group"
      ],
      "properties": {
        "plan_id": {
          "$ref": "#/$defs/nullableString"
        },
        "plan_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "group": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "completable_group": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "string",
              "enum": [
                "mixed",
                "none"
              ]
            }
          ]
        },
        "plan_json": {
          "$ref": "#/$defs/nullableString"
        },
        "stage": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "runtimeDispatchCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tracked",
        "ready",
        "active",
        "failed",
        "completed"
      ],
      "properties": {
        "tracked": {
          "type": "integer",
          "minimum": 0
        },
        "ready": {
          "type": "integer",
          "minimum": 0
        },
        "active": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "completed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "currentActionableDispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dispatch_id",
        "plan_id",
        "role",
        "group",
        "status"
      ],
      "properties": {
        "dispatch_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "plan_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "plan_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "role": {
          "$ref": "#/$defs/runtimeRole"
        },
        "group": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "$ref": "#/$defs/runtimeDispatchStatus"
        },
        "active_owner": {
          "anyOf": [
            {
              "$ref": "#/$defs/runtimeDispatchOwner"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_owner": {
          "anyOf": [
            {
              "$ref": "#/$defs/runtimeDispatchOwner"
            },
            {
              "type": "null"
            }
          ]
        },
        "freshness": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "pending",
            "fresh",
            "stale",
            "missing",
            "unchanged",
            null
          ]
        },
        "capsule_json": {
          "$ref": "#/$defs/nullableString"
        },
        "agent_type_hint": {
          "$ref": "#/$defs/nullableString"
        },
        "reasoning_effort_hint": {
          "$ref": "#/$defs/nullableString"
        },
        "result_artifacts": {
          "$ref": "#/$defs/stringArray"
        },
        "completion_requirements": {
          "$ref": "#/$defs/dispatchCompletionRequirements"
        },
        "instruction": {
          "$ref": "#/$defs/nullableString"
        },
        "lease_expires_at": {
          "$ref": "#/$defs/nullableString"
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "profile": {
      "const": "codex"
    },
    "project": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "created_at": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "updated_at": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "planning": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "verification": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "checked_at": {
              "$ref": "#/$defs/nullableString"
            },
            "stale": {
              "type": "boolean"
            },
            "reason": {
              "$ref": "#/$defs/nullableString"
            },
            "source_paths": {
              "$ref": "#/$defs/stringArray"
            },
            "verification_paths": {
              "$ref": "#/$defs/stringArray"
            },
            "stale_outputs": {
              "$ref": "#/$defs/stringArray"
            }
          }
        },
        "analysis": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "checker_result": {
              "$ref": "#/$defs/nullableString"
            },
            "auditor_result": {
              "$ref": "#/$defs/nullableString"
            },
            "blocking_findings": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "source": {
                    "$ref": "#/$defs/nonEmptyString"
                  },
                  "id": {
                    "$ref": "#/$defs/nonEmptyString"
                  },
                  "title": {
                    "$ref": "#/$defs/nonEmptyString"
                  },
                  "severity": {
                    "$ref": "#/$defs/nonEmptyString"
                  }
                }
              }
            }
          }
        },
        "status": {
          "$ref": "#/$defs/nullableString"
        },
        "intake_prompt": {
          "$ref": "#/$defs/nullableString"
        },
        "clarifying_questions": {
          "$ref": "#/$defs/stringArray"
        },
        "spec_path": {
          "$ref": "#/$defs/nullableString"
        },
        "spec_hash": {
          "$ref": "#/$defs/nullableString"
        },
        "planning_context_hash": {
          "$ref": "#/$defs/nullableString"
        },
        "draft_correction": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true,
          "properties": {
            "summary": {
              "$ref": "#/$defs/nullableString"
            },
            "questions": {
              "$ref": "#/$defs/stringArray"
            },
            "blockers": {
              "$ref": "#/$defs/stringArray"
            },
            "fix_targets": {
              "$ref": "#/$defs/stringArray"
            },
            "action_plan": {
              "$ref": "#/$defs/stringArray"
            },
            "phase_requirements": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "plan_id": {
                    "$ref": "#/$defs/nonEmptyString"
                  },
                  "issues": {
                    "$ref": "#/$defs/stringArray"
                  }
                }
              }
            }
          }
        }
      }
    },
    "current_plan": {
      "$ref": "#/$defs/workflowPlan"
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "status",
        "cycle_count",
        "last_started_at",
        "last_completed_at",
        "last_result",
        "next_action"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/lifecycleStatus"
        },
        "cycle_count": {
          "type": "integer",
          "minimum": 0
        },
        "last_started_at": {
          "$ref": "#/$defs/nullableString"
        },
        "last_completed_at": {
          "$ref": "#/$defs/nullableString"
        },
        "last_result": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "pass",
            "fail",
            null
          ]
        },
        "next_action": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "stop_reason": {
          "$ref": "#/$defs/nullableString"
        },
        "next_command": {
          "$ref": "#/$defs/nullableString"
        },
        "advance_behavior": {
          "anyOf": [
            {
              "$ref": "#/$defs/lifecycleAdvanceBehavior"
            },
            {
              "type": "null"
            }
          ]
        },
        "advance_behavior_detail": {
          "$ref": "#/$defs/nullableString"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "awaiting_runtime_dispatch"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "next_command",
              "advance_behavior",
              "advance_behavior_detail",
              "stop_reason"
            ],
            "properties": {
              "next_command": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "advance_behavior": {
                "$ref": "#/$defs/lifecycleAdvanceBehavior"
              },
              "advance_behavior_detail": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "stop_reason": {
                "$ref": "#/$defs/nonEmptyString"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "awaiting_fresh_session"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "next_command",
              "advance_behavior",
              "advance_behavior_detail",
              "stop_reason"
            ],
            "properties": {
              "next_command": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "advance_behavior": {
                "$ref": "#/$defs/lifecycleAdvanceBehavior"
              },
              "advance_behavior_detail": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "stop_reason": {
                "$ref": "#/$defs/nonEmptyString"
              }
            }
          }
        }
      ]
    },
    "workflow": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "auto_continue",
        "stop_on_failure",
        "max_phases_per_run",
        "plans"
      ],
      "properties": {
        "auto_continue": {
          "type": "boolean"
        },
        "stop_on_failure": {
          "type": "boolean"
        },
        "max_phases_per_run": {
          "type": "integer",
          "minimum": 1
        },
        "plans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/workflowPlan"
          }
        },
        "dependency_blockers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependencyBlocker"
          }
        },
        "actionable_dependency_targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/actionableDependencyTarget"
          }
        },
        "dependency_next_action": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "history": {
      "type": "array"
    },
    "gotchas": {
      "allOf": [
        {
          "$ref": "#/$defs/stringArray"
        },
        {
          "maxItems": 50
        }
      ]
    },
    "propagated_discoveries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/propagatedDiscovery"
      }
    },
    "orchestration": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "stage": {
          "type": "string",
          "enum": [
            "planning",
            "execution"
          ]
        },
        "active_role": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "strategist",
            "detailer",
            "checker",
            "auditor",
            "executor",
            "judge",
            "reviewer",
            "fixer",
            null
          ]
        },
        "last_role": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "strategist",
            "detailer",
            "checker",
            "auditor",
            "executor",
            "judge",
            "reviewer",
            "fixer",
            null
          ]
        },
        "next_role": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "strategist",
            "detailer",
            "checker",
            "auditor",
            "executor",
            "judge",
            "reviewer",
            "fixer",
            null
          ]
        },
        "discovery_propagation": {
          "type": "boolean"
        },
        "role_history": {
          "type": "array"
        },
        "runtime_dispatches": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "by_id"
          ],
          "properties": {
            "by_id": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/runtimeDispatchEntry"
              }
            }
          }
        },
        "runtime_dispatch_view": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "actionable_plan": {
              "type": [
                "object",
                "null"
              ],
              "allOf": [
                {
                  "if": {
                    "type": "object"
                  },
                  "then": {
                    "$ref": "#/$defs/runtimeDispatchViewActionablePlan"
                  }
                }
              ]
            },
            "ready_dispatches": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/currentActionableDispatch"
              }
            },
            "dispatch_counts": {
              "$ref": "#/$defs/runtimeDispatchCounts"
            },
            "delegation": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "current_actionable_dispatch": {
          "type": [
            "object",
            "null"
          ],
          "allOf": [
            {
              "if": {
                "type": "object"
              },
              "then": {
                "$ref": "#/$defs/currentActionableDispatch"
              }
            }
          ]
        },
        "current_actionable_capsule": {
          "$ref": "#/$defs/nullableString"
        },
        "capsules": {
          "type": "object"
        }
      }
    }
  }
}
